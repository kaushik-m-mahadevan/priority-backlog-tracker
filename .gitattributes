# Normalize line endings: LF in the repo, native on checkout.
* text=auto

*.java   text
*.xml    text
*.yml    text
*.yaml   text
*.md     text
*.properties text
*.html   text
*.css    text
*.js     text
*.ts     text
*.tsx    text
*.json   text

mvnw     text eol=lf
*.sh     text eol=lf
*.cmd    text eol=crlf
*.bat    text eol=crlf

*.jar    binary
*.png    binary
*.jpg    binary
*.ico    binary
