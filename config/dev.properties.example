# ─────────────────────────────────────────────────────────────────────────────
#  dev profile — LOCAL config.  Copy to  config/dev.properties  (gitignored).
#
#  Loaded when you run:  java -jar target/*.jar --spring.profiles.active=dev
#  (via spring.config.import in application-dev.yml). Launch from the project root.
#
#  These are plain Spring property keys and OVERRIDE application-dev.yml.
#  ⚠️  An empty value STILL overrides — don't leave a bare `key=` line; either set
#      it or keep it commented. You can also pass the env var instead (MONGODB_URI…).
# ─────────────────────────────────────────────────────────────────────────────

# Atlas connection string for the shared cluster, NO trailing /database:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
spring.data.mongodb.uri=

# ── optional overrides (defaults shown) ──
#spring.data.mongodb.database=dev
#app.jwt.secret=dev-secret-change-me
#app.jwt.expiration-minutes=1440
#app.demo-data.enabled=true
#app.seed-user.enabled=true
#app.seed-user.email=test123
#app.seed-user.password=test123
#app.seed-user.name=Test User
#app.seed-user.user-code=TST
