# ─────────────────────────────────────────────────────────────────────────────
#  dev profile — local config.  Copy this file to  config/dev.properties  and
#  fill in the values.  config/dev.properties is gitignored; this .example is
#  the checked-in reference.
#
#  Used automatically when you run:
#      java -jar target/*.jar --spring.profiles.active=dev
#  (wired via spring.config.import in application-dev.yml). Launch from the
#  project root so ./config/ resolves.
#
#  These are plain Spring property keys and OVERRIDE application-dev.yml.
#  An empty value still overrides — so leave a line commented (#) unless you
#  actually want to set it. Only the URI is required.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Atlas connection string for the shared cluster. NO trailing /database.
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
spring.data.mongodb.uri=

# ── optional overrides (defaults shown) ──
#spring.data.mongodb.database=dev
#app.jwt.secret=dev-secret-change-me
#app.jwt.expiration-minutes=1440
#app.demo-data.enabled=true
#app.seed-user.enabled=true
#app.seed-user.email=test123
#app.seed-user.password=test123
#app.seed-user.name=Test User
#app.seed-user.user-code=TST
