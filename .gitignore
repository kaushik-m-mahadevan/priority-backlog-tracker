target/
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.claude/

# Node / frontend build
node_modules/
src/main/frontend/node_modules/
src/main/frontend/dist/
# frontend-maven-plugin installs Node under target/ (already ignored) but be explicit
node/

# Playwright output
src/main/frontend/test-results/
src/main/frontend/playwright-report/

# Local env / secrets
application-local.yml
*.env
.env

# Per-profile local config loaded via spring.config.import — real values live here,
# never committed. The .example templates ARE committed as the scaffold.
/config/*.properties
!/config/*.properties.example

# OS
.DS_Store
Thumbs.db

# Local dev-data seed script (hits a running local instance directly over REST;
# not part of the build, never committed — see scripts/seed-local-data.mjs)
/scripts/

# compiled one-off ops tools
/ops/**/*.class
